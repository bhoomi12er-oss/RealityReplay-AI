# Meta Model API Configuration
# Official Base URL: https://api.meta.ai/v1 (or compatible endpoint e.g., https://api.groq.com/openai/v1)
META_BASE_URL=https://api.meta.ai/v1

# Meta Model API Key / Bearer Token
# NEVER expose this key in frontend code or client-side bundles!
META_API_KEY=

# Vision model identifier (e.g., muse-spark-1.3, llama-3.2-11b-vision, llama-3.2-90b-vision)
META_MODEL=muse-spark-1.3

# Backend Server Port
PORT=3001

